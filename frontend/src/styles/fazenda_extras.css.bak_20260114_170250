/* ============================================================
   FIX6: Mangas & Pasto — refaz "Mapa das mangas" (tiles) + toggle
   ============================================================ */

.cras-ui-v2 .faz-grid-2{
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 12px;
}
@media (max-width: 980px){
  .cras-ui-v2 .faz-grid-2{ grid-template-columns: 1fr; }
}

.cras-ui-v2 .faz-chipsRow{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.cras-ui-v2 .faz-chip{
  border: 1px solid rgba(226,232,240,.92);
  background: rgba(255,255,255,.86);
  border-radius: 999px;
  padding: 9px 12px;
  font-weight: 850;
  color: rgba(15,23,42,1);
}
.cras-ui-v2 .faz-chip.on{
  background: rgba(99,102,241,.12);
  border-color: rgba(199,210,254,.92);
  color: rgba(55,48,163,1);
}

.cras-ui-v2 .faz-input{
  width: 100%;
  border: 1px solid rgba(226,232,240,.92);
  background: rgba(255,255,255,.86);
  border-radius: 14px;
  padding: 10px 12px;
  font-size: 14px;
  outline: none;
}

.cras-ui-v2 .faz-subtitle{
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .14em;
  font-weight: 950;
  color: rgba(100,116,139,1);
}

/* Mini-métricas no Resumo */
.cras-ui-v2 .faz-metricGrid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.cras-ui-v2 .faz-miniMetric{
  border: 1px solid rgba(226,232,240,.92);
  background: rgba(248,250,252,.86);
  border-radius: 16px;
  padding: 10px 12px;
}
.cras-ui-v2 .faz-miniMetric .k{
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .14em;
  font-weight: 950;
  color: rgba(100,116,139,1);
}
.cras-ui-v2 .faz-miniMetric .v{
  margin-top: 6px;
  font-size: 22px;
  font-weight: 950;
  color: rgba(15,23,42,1);
}

/* Segmented (Mapa/Lista) */
.cras-ui-v2 .faz-seg{
  display:flex;
  gap: 6px;
  padding: 6px;
  border-radius: 999px;
  border: 1px solid rgba(226,232,240,.92);
  background: rgba(255,255,255,.86);
}
.cras-ui-v2 .faz-seg button{
  border: none;
  background: transparent;
  padding: 8px 12px;
  border-radius: 999px;
  font-weight: 900;
  color: rgba(100,116,139,1);
  cursor: pointer;
}
.cras-ui-v2 .faz-seg button.on{
  background: rgba(99,102,241,.12);
  color: rgba(55,48,163,1);
  box-shadow: 0 10px 22px rgba(99,102,241,.10);
}

/* Grid de tiles */
.cras-ui-v2 .faz-areaGrid{
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
  align-items: start;
}

/* Tile */
.cras-ui-v2 .faz-areaTile{
  border: 1px solid rgba(226,232,240,.92);
  background: rgba(255,255,255,.86);
  border-radius: 18px;
  padding: 12px;
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
  box-shadow: 0 18px 60px rgba(15,23,42,.06);
}
.cras-ui-v2 .faz-areaTile:hover{
  transform: translateY(-1px);
  border-color: rgba(199,210,254,.92);
  box-shadow: 0 22px 70px rgba(15,23,42,.08);
}
.cras-ui-v2 .faz-areaTile.isAlert{
  border-color: rgba(251,113,133,.40);
  box-shadow: 0 22px 70px rgba(251,113,133,.07);
}

.cras-ui-v2 .faz-areaTile .tHead{
  display:flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}
.cras-ui-v2 .faz-areaTile .tNum{
  font-size: 24px;
  font-weight: 950;
  color: rgba(15,23,42,1);
}
.cras-ui-v2 .faz-areaTile .b{
  font-size: 11px;
  font-weight: 950;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(226,232,240,.92);
  background: rgba(248,250,252,.86);
  color: rgba(100,116,139,1);
}
.cras-ui-v2 .faz-areaTile .b.ok{ background: rgba(34,197,94,.10); border-color: rgba(34,197,94,.20); color: rgba(22,101,52,1); }
.cras-ui-v2 .faz-areaTile .b.vaz{ background: rgba(99,102,241,.08); border-color: rgba(199,210,254,.92); color: rgba(55,48,163,1); }
.cras-ui-v2 .faz-areaTile .b.rest{ background: rgba(245,158,11,.10); border-color: rgba(245,158,11,.20); color: rgba(146,64,14,1); }
.cras-ui-v2 .faz-areaTile .b.bad{ background: rgba(244,63,94,.10); border-color: rgba(244,63,94,.18); color: rgba(159,18,57,1); }

.cras-ui-v2 .faz-areaTile .tBody{ margin-top: 10px; }
.cras-ui-v2 .faz-areaTile .tTitle{
  font-size: 13px;
  font-weight: 900;
  color: rgba(100,116,139,1);
}
.cras-ui-v2 .faz-areaTile .tSub{
  margin-top: 6px;
  font-size: 14px;
  font-weight: 950;
  color: rgba(15,23,42,1);
}
.cras-ui-v2 .faz-areaTile .tSub.hasLot{ color: rgba(17,24,39,1); }
.cras-ui-v2 .faz-areaTile .tMeta{
  margin-top: 6px;
  font-size: 12px;
  font-weight: 750;
  color: rgba(100,116,139,1);
}

.cras-ui-v2 .faz-areaTile .tActions{
  margin-top: 10px;
  display:flex;
  gap: 8px;
}
.cras-ui-v2 .faz-rowActions{ display:flex; gap: 8px; }

/* Tabela */
.cras-ui-v2 .faz-tableWrap{
  border: 1px solid rgba(226,232,240,.92);
  border-radius: 18px;
  overflow:hidden;
  background: rgba(255,255,255,.86);
}
.cras-ui-v2 .faz-table{
  width: 100%;
  border-collapse: collapse;
}
.cras-ui-v2 .faz-table thead th{
  text-align: left;
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: rgba(100,116,139,1);
  padding: 12px 14px;
  background: rgba(248,250,252,.86);
  border-bottom: 1px solid rgba(226,232,240,.92);
}
.cras-ui-v2 .faz-table td{
  padding: 12px 14px;
  border-bottom: 1px solid rgba(226,232,240,.60);
  vertical-align: top;
}
.cras-ui-v2 .faz-table .tdStrong{ font-weight: 950; color: rgba(15,23,42,1); }
.cras-ui-v2 .faz-table .tdMuted{ font-weight: 750; color: rgba(100,116,139,1); }
.cras-ui-v2 .faz-table .tdEmpty{ padding: 18px 14px; color: rgba(100,116,139,1); font-weight: 800; }

.cras-ui-v2 .faz-pill{
  display:inline-flex;
  align-items:center;
  gap:6px;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: .08em;
  text-transform: uppercase;
  border: 1px solid rgba(226,232,240,.92);
  background: rgba(248,250,252,.86);
  color: rgba(100,116,139,1);
}
.cras-ui-v2 .faz-pill.b.ok{ background: rgba(34,197,94,.10); border-color: rgba(34,197,94,.20); color: rgba(22,101,52,1); }
.cras-ui-v2 .faz-pill.b.vaz{ background: rgba(99,102,241,.08); border-color: rgba(199,210,254,.92); color: rgba(55,48,163,1); }
.cras-ui-v2 .faz-pill.b.rest{ background: rgba(245,158,11,.10); border-color: rgba(245,158,11,.20); color: rgba(146,64,14,1); }
.cras-ui-v2 .faz-pill.b.bad{ background: rgba(244,63,94,.10); border-color: rgba(244,63,94,.18); color: rgba(159,18,57,1); }

.cras-ui-v2 .faz-empty{
  border: 1px dashed rgba(226,232,240,.92);
  background: rgba(248,250,252,.86);
  border-radius: 18px;
  padding: 18px;
  color: rgba(100,116,139,1);
}
.cras-ui-v2 .faz-empty .title{
  font-weight: 950;
  color: rgba(15,23,42,1);
}
.cras-ui-v2 .faz-empty .desc{
  margin-top: 4px;
  font-weight: 750;
}
