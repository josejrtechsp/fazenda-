/* IDEAL Fazenda — Rebanho | Animais (Lista)
   Escopo: apenas dentro da aba Rebanho (.faz-herd)
*/

.faz-herd .faz-rowActions{display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end}

/* Botões de ação do Rebanho (compactos e harmônicos) */
.faz-herd .faz-rowActions .faz-btn{
  border:1px solid rgba(226,232,240,.95);
  background:#fff;
  border-radius:999px;
  padding:6px 10px;
  font-size:12px;
  font-weight:850;
  line-height:1;
  min-height:30px;
  box-shadow:0 10px 26px rgba(15,23,42,.06);
}

.faz-herd .faz-rowActions .faz-btn:hover{
  border-color:rgba(124,58,237,.55);
}

/* 4º botão é "Baixa" na lista — destaque suave */
.faz-herd .faz-rowActions .faz-btn:nth-child(4){
  border-color:rgba(244,63,94,.55);
}
.faz-herd .faz-rowActions .faz-btn:nth-child(4):hover{
  border-color:rgba(244,63,94,.85);
  box-shadow:0 14px 34px rgba(244,63,94,.12);
}

.faz-herd .faz-input{
  border:1px solid rgba(226,232,240,.95);
  border-radius:10px;
  padding:8px 10px;
  font-size:13px;
  min-height:36px;
  background:#fff;
  outline:none;
}

.faz-herd .faz-input:focus{
  border-color:rgba(124,58,237,.55);
  box-shadow:0 0 0 3px rgba(124,58,237,.10);
}

.faz-herd .faz-pill{
  border:1px solid rgba(226,232,240,.95);
  background:#fff;
  border-radius:999px;
  padding:6px 10px;
  font-size:12px;
  color:rgba(15,23,42,.85);
  display:flex;
  align-items:center;
  gap:6px;
}

.faz-herd .faz-tableWrap{overflow:auto;border:1px solid rgba(226,232,240,.85);border-radius:12px}

.faz-herd .faz-table{width:100%;border-collapse:separate;border-spacing:0;background:#fff}

.faz-herd .faz-table thead th{
  position:sticky;
  top:0;
  background:#fff;
  font-size:11px;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:rgba(100,116,139,1);
  text-align:left;
  padding:10px 10px;
  border-bottom:1px solid rgba(226,232,240,.85);
}

.faz-herd .faz-table tbody td{
  padding:10px 10px;
  border-bottom:1px solid rgba(241,245,249,.9);
  font-size:13px;
  color:rgba(15,23,42,.92);
  vertical-align:middle;
}

.faz-herd .faz-table tbody tr:hover{background:rgba(124,58,237,.04)}

.faz-herd .tdMuted{color:rgba(100,116,139,1)}
.faz-herd .tdStrong{font-weight:900}
.faz-herd .tdEmpty{color:rgba(100,116,139,1);text-align:center;padding:18px 10px}

.faz-herd button.link{
  border:none;
  background:transparent;
  padding:0;
  cursor:pointer;
  color:rgba(15,23,42,1);
}
.faz-herd button.link:hover{text-decoration:underline}

/* --- Ficha do Animal (V1) --- */
.faz-herd .faz-ficha-top{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.faz-herd .faz-stat{
  border:1px solid transparent;
  background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(124,58,237,.9), rgba(34,197,94,.9)) border-box;
  border-radius:14px;
  padding:10px 12px;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
}
.faz-herd .faz-stat .k{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(100,116,139,1);font-weight:900}
.faz-herd .faz-stat .v{margin-top:6px;font-size:18px;font-weight:950;color:rgba(15,23,42,1)}
.faz-herd .faz-stat .s{margin-top:6px;font-size:12px;color:rgba(100,116,139,1);font-weight:650}

/* Estados visuais (Ficha) */
.faz-herd .faz-stat.is-warn{
  background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(244,63,94,.85), rgba(245,158,11,.85)) border-box;
}
.faz-herd .faz-stat.is-pos{
  background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(34,197,94,.95), rgba(14,165,233,.85)) border-box;
}
.faz-herd .faz-stat.is-neg{
  background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(244,63,94,.90), rgba(124,58,237,.75)) border-box;
}

.faz-herd .faz-badges{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.faz-herd .faz-badge{
  border:1px solid rgba(226,232,240,.95);
  background:#fff;
  border-radius:999px;
  padding:6px 10px;
  font-size:12px;
  font-weight:850;
  color:rgba(15,23,42,.9);
  box-shadow:0 10px 26px rgba(15,23,42,.06);
}
.faz-herd .faz-badge.is-ok{border-color:rgba(34,197,94,.45)}
.faz-herd .faz-badge.is-warn{border-color:rgba(245,158,11,.55)}
.faz-herd .faz-badge.is-bad{border-color:rgba(244,63,94,.55)}

/* Botão "Dar baixa" */
.faz-herd .faz-btn.danger{
  border-color:rgba(244,63,94,.55);
}
.faz-herd .faz-btn.danger:hover{
  border-color:rgba(244,63,94,.85);
  box-shadow:0 14px 34px rgba(244,63,94,.12);
}

.faz-herd .faz-ficha-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:12px}
@media (max-width: 980px){.faz-herd .faz-ficha-grid{grid-template-columns:1fr;}}

.faz-herd .faz-panel{
  border:1px solid transparent;
  background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(124,58,237,.9), rgba(34,197,94,.9)) border-box;
  border-radius:16px;
  padding:12px 12px;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
}

.faz-herd .faz-chart{height:120px;border:1px dashed rgba(226,232,240,.95);border-radius:12px;display:flex;align-items:center;justify-content:center;color:rgba(124,58,237,.85)}
.faz-herd .faz-chart-svg{width:100%;height:100%;color:rgba(124,58,237,.9)}

.faz-herd .faz-weigh-form{border:1px solid rgba(226,232,240,.95);border-radius:12px;padding:10px 10px;background:#fff}

.faz-herd .faz-timeline-row{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid rgba(241,245,249,.9)}
.faz-herd .faz-timeline-row:last-child{border-bottom:none}
.faz-herd .faz-timeline-row .dot{width:10px;height:10px;border-radius:50%;background:linear-gradient(135deg, rgba(124,58,237,.9), rgba(34,197,94,.9));margin-top:4px;flex:0 0 auto}

.faz-herd .link.ear{font-weight:950}

/* pequenos ajustes de botões em linha */
.faz-herd .faz-btn{white-space:nowrap}


/* --- Modal de Baixa --- */
.faz-herd .faz-modalBack{
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,.28);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  z-index: 9999;
}
.faz-herd .faz-modal{
  width: min(720px, 96vw);
  background: #fff;
  border-radius: 16px;
  border: 1px solid rgba(226,232,240,.95);
  box-shadow: 0 24px 80px rgba(15,23,42,.18);
  padding: 14px;
}
.faz-herd .faz-modalHead{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.faz-herd .faz-modalTitle{font-weight:950;font-size:16px}
.faz-herd .faz-modalSub{font-size:12px;color:rgba(100,116,139,1);margin-top:2px}
.faz-herd .faz-modalErr{margin-top:10px;border:1px solid rgba(244,63,94,.35);background:rgba(244,63,94,.06);padding:10px;border-radius:12px;color:rgba(127,29,29,1);font-size:13px}
.faz-herd .faz-modalGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}
@media (max-width: 720px){.faz-herd .faz-modalGrid{grid-template-columns:1fr;}}
.faz-herd .faz-modalActions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}

/* FIX27 — Sanidade junto com pesagem */
.faz-herd .faz-healthBox{
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(226,232,240,.9);
  background: rgba(248,250,252,.75);
}
.faz-herd .faz-healthToggle{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight: 850;
  font-size: 12px;
  color: rgba(15,23,42,1);
}
.faz-herd .faz-healthToggle input{ transform: translateY(1px); }
.faz-herd .faz-healthGrid{
  margin-top: 10px;
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.faz-herd .faz-healthOptions{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.faz-herd .faz-healthOpt{
  display:flex;
  align-items:center;
  gap:8px;
  padding: 6px 8px;
  border-radius: 12px;
  border: 1px solid rgba(226,232,240,.9);
  background: #fff;
  font-size: 12px;
}
.faz-herd .faz-healthOpt .lbl{ font-weight: 750; }
.faz-herd .faz-healthSectionTitle{
  font-size: 10px;
  font-weight: 950;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(100,116,139,1);
  padding: 2px 4px;
}
.faz-herd .faz-healthMeta{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.faz-herd .faz-timeline-row .dot.health{
  background: linear-gradient(135deg, rgba(34,197,94,1), rgba(14,165,233,1));
}



/* === Rebanho UX V7 — redesenho Visão geral + Lotes (mais limpo e operável) === */

.faz-herd .herdDash{display:flex;flex-direction:column;gap:12px}
.faz-herd .herdKpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
@media (max-width:1100px){.faz-herd .herdKpis{grid-template-columns:repeat(2,minmax(0,1fr));}}

.faz-herd .herdKpi{
  border:1px solid transparent;
  background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(124,58,237,.9), rgba(34,197,94,.9)) border-box;
  border-radius:16px;
  padding:12px 12px;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
}
.faz-herd .herdKpi .label{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(100,116,139,1);font-weight:950}
.faz-herd .herdKpi .value{margin-top:8px;font-size:22px;font-weight:950;color:rgba(15,23,42,1)}
.faz-herd .herdKpi .hint{margin-top:6px;font-size:12px;color:rgba(100,116,139,1);font-weight:650}
.faz-herd .herdKpi.is-pos{background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(34,197,94,.95), rgba(14,165,233,.85)) border-box;}
.faz-herd .herdKpi.is-warn{background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(245,158,11,.92), rgba(124,58,237,.75)) border-box;}
.faz-herd .herdKpi.is-bad{background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg, rgba(244,63,94,.90), rgba(124,58,237,.75)) border-box;}

.faz-herd .herdGrid2{display:grid;grid-template-columns:1.15fr .85fr;gap:12px}
@media (max-width:980px){.faz-herd .herdGrid2{grid-template-columns:1fr;}}

.faz-herd .herdPanel{
  border:1px solid rgba(226,232,240,.95);
  border-radius:16px;
  padding:12px;
  background:#fff;
  box-shadow:0 14px 40px rgba(15,23,42,.05);
}
.faz-herd .herdPanelHead{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.faz-herd .herdPanelHead .title{font-weight:950;font-size:14px}
.faz-herd .herdPanelHead .sub{margin-top:2px;font-size:12px;color:rgba(100,116,139,1)}

.faz-herd .herdChips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.faz-herd .herdChip{
  border:1px solid rgba(226,232,240,.95);
  background:#fff;
  border-radius:999px;
  padding:7px 10px;
  display:flex;
  gap:8px;
  align-items:center;
  font-size:12px;
  font-weight:850;
  cursor:pointer;
}
.faz-herd .herdChip:hover{border-color:rgba(124,58,237,.55);box-shadow:0 12px 30px rgba(15,23,42,.08)}
.faz-herd .herdChip .k{color:rgba(15,23,42,.92)}
.faz-herd .herdChip .count{color:rgba(100,116,139,1);font-weight:950}

.faz-herd .herdQuick{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}

.faz-herd .herdAlerts{display:grid;grid-template-columns:1fr;gap:12px;margin-top:10px}
.faz-herd .herdAlertBlock .h{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(100,116,139,1);font-weight:950;margin-bottom:8px}
.faz-herd .herdAlertRow{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  border:1px solid rgba(226,232,240,.9);
  background:#fff;
  padding:8px 10px;
  border-radius:14px;
  margin-bottom:8px;
  cursor:pointer;
  text-align:left;
}
.faz-herd .herdAlertRow:hover{border-color:rgba(124,58,237,.55);box-shadow:0 12px 30px rgba(15,23,42,.08)}
.faz-herd .herdAlertRow .ear{font-weight:950}
.faz-herd .herdAlertRow .meta{flex:1;color:rgba(100,116,139,1);font-size:12px}
.faz-herd .herdAlertRow .pill{border-radius:999px;padding:4px 8px;font-size:12px;font-weight:950;border:1px solid rgba(226,232,240,.9)}
.faz-herd .herdAlertRow .pill.warn{border-color:rgba(245,158,11,.55)}
.faz-herd .herdAlertRow .pill.bad{border-color:rgba(244,63,94,.55)}

.faz-herd .herdLink{border:none;background:transparent;color:rgba(124,58,237,1);font-weight:900;cursor:pointer;padding:0;margin-top:2px}
.faz-herd .herdLink:hover{text-decoration:underline}

/* Lotes (master-detail) */
.faz-herd .herdLots{display:grid;grid-template-columns:360px 1fr;gap:12px;align-items:start}
@media (max-width:980px){.faz-herd .herdLots{grid-template-columns:1fr;}}

.faz-herd .herdLotsHead{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.faz-herd .herdLotsHead .ttl{font-weight:950}

.faz-herd .herdLotsSearch{margin-top:10px;width:100%}
.faz-herd .herdLotList{margin-top:10px;display:flex;flex-direction:column;gap:8px;max-height:520px;overflow:auto;padding-right:2px}

.faz-herd .herdLotCard{
  width:100%;
  border:1px solid rgba(226,232,240,.95);
  background:#fff;
  border-radius:16px;
  padding:10px 12px;
  text-align:left;
  cursor:pointer;
}
.faz-herd .herdLotCard:hover{border-color:rgba(124,58,237,.55);box-shadow:0 12px 30px rgba(15,23,42,.08)}
.faz-herd .herdLotCard.is-active{border-color:rgba(124,58,237,.75);box-shadow:0 14px 34px rgba(124,58,237,.12)}
.faz-herd .herdLotCard .top{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.faz-herd .herdLotCard .name{font-weight:950}
.faz-herd .herdLotCard .heads{font-weight:950;color:rgba(15,23,42,.92)}
.faz-herd .herdLotCard .heads span{font-size:11px;color:rgba(100,116,139,1);font-weight:850;margin-left:4px}
.faz-herd .herdLotCard .sub{margin-top:2px;font-size:12px;color:rgba(100,116,139,1)}

.faz-herd .herdLotHeader{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
.faz-herd .herdLotTitle{font-weight:950;font-size:16px}
.faz-herd .herdLotSub{margin-top:2px;font-size:12px;color:rgba(100,116,139,1)}

.faz-herd .herdLotBadges{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:flex-end}
.faz-herd .herdBadge{border:1px solid rgba(226,232,240,.9);background:#fff;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:900;color:rgba(15,23,42,.9)}
.faz-herd .herdBadge.warn{border-color:rgba(245,158,11,.55)}
.faz-herd .herdBadge.bad{border-color:rgba(244,63,94,.55)}

.faz-herd .herdLotTools{display:flex;gap:10px;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;margin-top:12px}
.faz-herd .herdLotTools .left{flex:1;min-width:240px}
.faz-herd .herdLotTools .right{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.faz-herd .herdToggle{display:flex;align-items:center;gap:8px;border:1px solid rgba(226,232,240,.95);border-radius:999px;padding:6px 10px;background:#fff;font-size:12px;font-weight:850;color:rgba(15,23,42,.9)}

.faz-herd .herdAnimalList{margin-top:12px;display:flex;flex-direction:column;gap:8px}
.faz-herd .herdAnimalItem{display:flex;justify-content:space-between;align-items:center;gap:10px;border:1px solid rgba(226,232,240,.9);border-radius:16px;padding:10px 12px;background:#fff;cursor:pointer}
.faz-herd .herdAnimalItem:hover{border-color:rgba(124,58,237,.55);box-shadow:0 12px 30px rgba(15,23,42,.08)}
.faz-herd .herdAnimalItem.is-alert{border-color:rgba(245,158,11,.55);background:rgba(245,158,11,.04)}
.faz-herd .herdAnimalItem .ear{font-weight:950}
.faz-herd .herdAnimalItem .meta{margin-top:2px;font-size:12px;color:rgba(100,116,139,1)}
.faz-herd .herdAnimalItem .side{display:flex;align-items:center;gap:10px}
.faz-herd .herdAnimalItem .days{font-weight:950;color:rgba(100,116,139,1)}
.faz-herd .herdAnimalItem .days.warn{color:rgba(180,83,9,1)}
.faz-herd .herdAnimalItem .actions{display:flex;gap:6px}
.faz-herd .herdMiniBtn{border:1px solid rgba(226,232,240,.95);background:#fff;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:900;cursor:pointer}
.faz-herd .herdMiniBtn:hover{border-color:rgba(124,58,237,.55)}

/* Animais: barra de filtros mais agradável */
.faz-herd .herdFilters{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px;justify-content:flex-start}

/* =========================================================
   UX V8 — Rebanho (Visão geral / Lotes / Animais)
   Motivo: classes usadas no Herd.jsx não tinham styling (Safari mostrava botões/linhas "cruas").
   Escopo: somente dentro do módulo Rebanho (.faz-herd)
   ========================================================= */

.faz-herd .faz-detail-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
  gap:10px;
}

.faz-herd .faz-mini{
  border:1px solid rgba(226,232,240,.92);
  background:#fff;
  border-radius:14px;
  padding:10px 12px;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
  min-height:74px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.faz-herd .faz-mini .k{
  font-size:11px;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:rgba(100,116,139,1);
  font-weight:900;
}
.faz-herd .faz-mini .v{
  margin-top:6px;
  font-size:20px;
  font-weight:950;
  color:rgba(15,23,42,1);
  line-height:1.1;
}

.faz-herd .faz-mini.is-warn{
  border-color:rgba(245,158,11,.55);
  background:rgba(245,158,11,.06);
}
.faz-herd .faz-mini.is-bad{
  border-color:rgba(244,63,94,.55);
  background:rgba(244,63,94,.05);
}
.faz-herd .faz-mini.is-good{
  border-color:rgba(34,197,94,.55);
  background:rgba(34,197,94,.05);
}

.faz-herd .faz-actions-row{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  align-items:center;
}

/* inputs dentro do Rebanho (algumas telas usam className="input") */
.faz-herd .input,
.faz-herd .faz-input{
  border:1px solid rgba(226,232,240,.95);
  border-radius:12px;
  padding:9px 10px;
  font-size:13px;
  min-height:38px;
  background:#fff;
  outline:none;
  width:100%;
}
.faz-herd .input:focus,
.faz-herd .faz-input:focus{
  border-color:rgba(124,58,237,.55);
  box-shadow:0 0 0 3px rgba(124,58,237,.10);
}
.faz-herd .form-label{
  display:block;
  font-size:11px;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:rgba(100,116,139,1);
  font-weight:900;
  margin:0 0 6px;
}

/* --- Lotes (lista à esquerda) --- */
.faz-herd .faz-lots{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-top:10px;
}
.faz-herd .faz-lot-row{
  width:100%;
  border:1px solid rgba(226,232,240,.92);
  background:#fff;
  border-radius:14px;
  padding:10px 12px;
  cursor:pointer;
  text-align:left;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
}
.faz-herd .faz-lot-row:hover{
  border-color:rgba(124,58,237,.45);
  background:rgba(124,58,237,.04);
}
.faz-herd .faz-lot-row.is-active{
  border-color:rgba(124,58,237,.65);
  box-shadow:0 18px 52px rgba(124,58,237,.10);
}
.faz-herd .faz-lot-row .left .name{
  font-weight:950;
  color:rgba(15,23,42,1);
  font-size:14px;
}
.faz-herd .faz-lot-row .left .sub{
  margin-top:2px;
  font-size:12px;
  color:rgba(100,116,139,1);
  font-weight:650;
}
.faz-herd .faz-lot-row .right{
  text-align:right;
  min-width:72px;
}
.faz-herd .faz-lot-row .right .num{
  font-weight:950;
  font-size:16px;
  color:rgba(15,23,42,1);
  line-height:1.1;
}
.faz-herd .faz-lot-row .right .muted{
  font-size:11px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:rgba(100,116,139,1);
  font-weight:900;
  margin-top:2px;
}

/* --- Animais (lista do lote à direita) --- */
.faz-herd .faz-animals{
  margin-top:10px;
  display:flex;
  flex-direction:column;
  gap:8px;
}
.faz-herd .faz-animal-row{
  border:1px solid rgba(226,232,240,.92);
  background:#fff;
  border-radius:14px;
  padding:10px 12px;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}
.faz-herd .faz-animal-row .meta{
  color:rgba(100,116,139,1);
  font-size:12px;
  font-weight:650;
  flex:1 1 260px;
  min-width:220px;
}
.faz-herd .faz-animal-row.is-alert{
  border-color:rgba(245,158,11,.55);
  background:rgba(245,158,11,.06);
}
.faz-herd .faz-animal-row .ear{
  font-weight:950;
}

/* ações "Pesagem / Mover" dentro das listas — ficam consistentes */
.faz-herd .faz-animal-row .faz-btn,
.faz-herd .faz-actions-row .faz-btn{
  border:1px solid rgba(226,232,240,.95);
  background:#fff;
  border-radius:999px;
  padding:7px 10px;
  font-size:12px;
  font-weight:850;
  line-height:1;
  min-height:30px;
  box-shadow:0 10px 26px rgba(15,23,42,.06);
}
.faz-herd .faz-animal-row .faz-btn:hover,
.faz-herd .faz-actions-row .faz-btn:hover{
  border-color:rgba(124,58,237,.55);
}
.faz-herd .faz-btn.primary{
  border-color:rgba(124,58,237,.55);
  background:rgba(124,58,237,.06);
}

/* compacta um pouco o split (melhor uso de tela) */
.faz-herd .cras-enc-split{
  gap:12px;
}
