import React, { useEffect, useMemo, useState } from "react";
import CrasPageHeader from "../components/CrasPageHeader.jsx";
import { api, getApiBase } from "../lib/api.js";

function formatBRL(v){
  const n = Number(v);
  if (!Number.isFinite(n)) return "—";
  try { return n.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }); } catch { return `R$ ${n}`; }
}

function formatBRLPerArroba(v){
  const n = Number(v);
  if (!Number.isFinite(n)) return "—";
  const s = formatBRL(n);
  return `${s}/@`;
}

function toMonthLabel(key){
  if (!key || !/^\d{4}-\d{2}$/.test(key)) return key || "";
  const y = Number(key.slice(0,4));
  const m = Number(key.slice(5,7));
  const meses = ["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"];
  return `${meses[m-1]}/${y}`;
}

function Modal({ open, title, children, onClose }){
  if (!open) return null;
  return (
    <>
    <div className="faz-modal-backdrop" role="dialog" aria-modal="true">
      <div className="faz-modal">
        <div className="faz-modal-head">
          <div>
            <div className="faz-modal-title">{title}</div>
            <div className="faz-modal-sub">Registro rápido (entra no relatório do mês)</div>
          </div>
          <button className="faz-btn" type="button" onClick={onClose}>Fechar</button>
        </div>
        <div className="faz-modal-body">{children}</div>
      </div>
    </div>
  );
}

export default function ProducerDashboard({ monthKey, onMonthChange }){
  const [loading, setLoading] = useState(false);
  const [err, setErr] = useState(null);
  const [data, setData] = useState(null);

  const [openExit, setOpenExit] = useState(false);
  const [exitArrobas, setExitArrobas] = useState(0);
  const [exitValue, setExitValue] = useState(0);

  const [openCost, setOpenCost] = useState(false);
  const [costGroup, setCostGroup] = useState("Nutrição");
  const [costValue, setCostValue] = useState(0);

  const apiBase = useMemo(() => getApiBase(), []);

  async function load(){
    setLoading(true);
    setErr(null);
    try {
      const res = await api.get(`/producer/monthly-summary?month=${encodeURIComponent(monthKey)}`);
      setData(res);
    } catch (e){
      setErr(e?.message || "Falha ao carregar");
      setData(null);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => { load(); /* eslint-disable-next-line */ }, [monthKey]);

  const kpis = useMemo(() => {
    if (!data) {
      return [
        { label: "@ produzidas (mês)", value: "—", sub: `Período: ${toMonthLabel(monthKey)}` },
        { label: "Custo (R$/@)", value: "—", sub: "Sempre por arroba produzida" },
        { label: "Preço médio (R$/@)", value: "—", sub: "Vendas/abates do mês" },
        { label: "Margem (R$/@)", value: "—", sub: "Preço − custo" },
        { label: "Margem total (R$)", value: "—", sub: "Margem/@ × @ vendidas" },
      ];
    }

    const arrobas = data.arrobas ?? 0;
    const costPer = data.cost_per_arroba_brl;
    const pricePer = data.price_per_arroba_brl;
    const marginPer = data.margin_per_arroba_brl;
    const marginTotal = data.margin_total_brl;

    return [
      { label: "@ produzidas (mês)", value: `${Number(arrobas).toLocaleString("pt-BR")} @`, sub: `Período: ${data.month_label || toMonthLabel(monthKey)}` },
      { label: "Custo (R$/@)", value: costPer == null ? "—" : formatBRLPerArroba(costPer), sub: "Sempre por arroba produzida" },
      { label: "Preço médio (R$/@)", value: pricePer == null ? "—" : formatBRLPerArroba(pricePer), sub: "Vendas/abates do mês" },
      { label: "Margem (R$/@)", value: marginPer == null ? "—" : formatBRLPerArroba(marginPer), sub: "Preço − custo" },
      { label: "Margem total (R$)", value: marginTotal == null ? "—" : formatBRL(marginTotal), sub: "Margem/@ × @ vendidas" },
    ];
  }, [data, monthKey]);

  const top5 = useMemo(() => {
    if (!data?.top_costs) return [];
    const total = Number(data.cost_total_brl || 0);
    const arrobas = Number(data.arrobas || 0);
    return (data.top_costs || []).map((x) => {
      const val = Number(x.value_brl || 0);
      const pct = total > 0 ? (val / total) : 0;
      const impact = (arrobas > 0) ? `+${formatBRL(val/arrobas)}/@` : "";
      return { name: x.group, pct, val, impact };
    });
  }, [data]);

  const alerts = useMemo(() => {
    if (!data?.alerts) return [];
    return data.alerts.map(a => a.text);
  }, [data]);

  const summaryLines = useMemo(() => {
    return data?.summary_lines || [];
  }, [data]);

  const hasArrobas = Number(data?.arrobas || 0) > 0;
  const hasCosts = Number(data?.cost_total_brl || 0) > 0;

  async function registerExit(){
    const arrobas = Number(exitArrobas);
    const value = Number(exitValue);
    if (!Number.isFinite(arrobas) || arrobas <= 0) return alert("Informe @ (arrobas) maior que zero.");
    if (!Number.isFinite(value) || value < 0) return alert("Informe valor total (R$).");

    try {
      await api.post("/events", {
        source: "app",
        status: "approved",
        type: "exit",
        raw_text: `Saída — ${arrobas} @ — ${formatBRL(value)}`,
        payload: { arrobas, value_brl: value },
      });
      setOpenExit(false);
      setExitArrobas(0);
      setExitValue(0);
      await load();
      alert("Saída registrada.");
    } catch (e){
      alert(e?.message || "Falha ao registrar saída");
    }
  }

  async function registerCost(){
    const value = Number(costValue);
    if (!Number.isFinite(value) || value <= 0) return alert("Informe um valor (R$) maior que zero.");
    const group = costGroup || "Máquinas/Infra/Outros";

    try {
      await api.post("/events", {
        source: "app",
        status: "approved",
        type: "cost",
        raw_text: `Custo — ${group} — ${formatBRL(value)}`,
        payload: { group, value_brl: value },
      });
      setOpenCost(false);
      setCostValue(0);
      await load();
      alert("Custo registrado.");
    } catch (e){
      alert(e?.message || "Falha ao registrar custo");
    }
  }

  return (
    <div className="cras-stage-v2 faz-producer">
      <CrasPageHeader
        eyebrow="Relatório do produtor"
        title="Resumo do mês"
        subtitle="Custo sempre em R$/@ produzida — leitura rápida e objetiva."
        bullets={["Mês", (data?.month_label || toMonthLabel(monthKey)), "R$/@"]}
        actions={[
          { key: "reload", label: loading ? "Atualizando…" : "Atualizar", tone: "primary" },
        ]}
        onAction={(a) => {
          if (a?.key === "reload") load();
        }}
      />

      <div className="cras-stage-body">
        <div className="faz-grid-kpis faz-grid-kpis--compact">
          {kpis.map((k) => (
            <div key={k.label} className="faz-kpi">
              <div className="label">{k.label}</div>
              <div className="value">{k.value}</div>
              <div className="sub">{k.sub}</div>
            </div>
          ))}
        </div>

        <div className="faz-row">
          <div className="faz-panel">
            <h3>Evolução do custo (R$/@) — últimos 6 meses</h3>
<div className="faz-muted" style={{ marginTop: 4 }}>Tendência calculada pelo backend.</div>

{(data?.trend || []).every((t) => !t?.cost_per_arroba_brl) ? (
  <div className="faz-empty" style={{ marginTop: 10 }}>
    <div className="ic">📈</div>
    <div>
      <div className="t">Sem tendência ainda</div>
      <div className="d">Quando existir @ produzida e custos, a tendência aparece automaticamente.</div>
    </div>
  </div>
) : (
  <div className="faz-trendlist" style={{ marginTop: 12 }}>
    {(data?.trend || []).map((t) => {
      const v = t?.cost_per_arroba_brl || 0;
      const maxv = Math.max(1, data?.trend_max || 1);
      const pct = Math.max(6, Math.min(100, (v / maxv) * 100));
      return (
        <div className="faz-trendrow" key={t.month}>
          <div className="m">{t.label}</div>
          <div className="bar"><div className="fill" style={{ width: pct + "%" }} /></div>
          <div className="v">{v ? ("R$ " + v.toFixed(2).replace(".", ",") + "/@") : "—"}</div>
        </div>
      );
    })}
  </div>
)}</div>
          </div>

          <div className="faz-panel">
  <div className="faz-topcost-head">
    <div>
      <h3>O que mais puxou seu custo</h3>
      <div className="faz-muted" style={{ marginTop: 4 }}>
        Top 5 categorias (fixas) · Total no mês: <b>{formatBRL(data?.cost_total_brl || 0)}</b>
      </div>
    </div>

    <div className="faz-topcost-metrics">
      <div className="faz-miniMetric">
        <div className="k">R$/@</div>
        <div className="v">{data?.cost_per_arroba_brl == null ? "—" : formatBRLPerArroba(data.cost_per_arroba_brl)}</div>
      </div>
      <div className="faz-miniMetric">
        <div className="k">@</div>
        <div className="v">{Number(data?.arrobas || 0).toLocaleString("pt-BR")}</div>
      </div>
    </div>
  </div>

  {!hasCosts ? (
    <div className="faz-empty">
      <div className="ic">📌</div>
      <div>
        <div className="t">Sem custos registrados no mês</div>
        <div className="d">Use “Lançar custo” (abaixo) ou registre pelo WhatsApp para aparecer aqui.</div>
      </div>
    </div>
  ) : (
    <div className="faz-bars faz-bars-compact">
      {top5.map((b) => (
        <div key={b.name} className="faz-bar">
          <div className="name">{b.name}</div>
          <div className="track">
            <div className="fill" style={{ width: `${Math.round(b.pct*100)}%` }} />
          </div>
          <div className="val">
            {formatBRL(b.val)}
            <div className="faz-muted" style={{ fontSize: 11 }}>{b.impact}</div>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

        </div>

        <div className="faz-panel faz-bottom" style={{ marginTop: 12 }}>
  <div className="faz-bottom-grid">
    <div className="faz-bottom-left">
      <div className="faz-bottom-title">Resumo do mês</div>

      <div className="faz-summary-lines">
        {summaryLines.length ? summaryLines.map((l, i) => (
          <div key={i} className="faz-sline">
            <span className="dot" />
            <span className="t">{l}</span>
          </div>
        )) : (
          <div className="faz-muted">Sem dados.</div>
        )}
      </div>

      {!hasArrobas ? (
        <div className="faz-callout info" style={{ marginTop: 10 }}>
          <div className="ic">i</div>
          <div className="tx">
            Sem @ produzida no mês. Registre <b>venda/abate</b> (saída) ou <b>pesagens</b> para calcular <b>R$/@</b>.
          </div>
        </div>
      ) : null}

      {alerts.length ? (
        <div className="faz-alerts-compact" style={{ marginTop: 12 }}>
          {alerts.slice(0, 5).map((t, i) => (
            <div key={i} className="faz-alert faz-alert-compact">
              <div className="dot" />
              <div className="txt">{t}</div>
            </div>
          ))}
        </div>
      ) : null}
    </div>

    <div className="faz-bottom-right">
      <div className="faz-bottom-title">Ações rápidas</div>

      <div className="faz-actions-grid">
        <button className="faz-btn primary sm" type="button" onClick={() => setOpenExit(true)}>
          Registrar venda/saída
        </button>
        <button className="faz-btn sm" type="button" onClick={() => setOpenCost(true)}>
          Lançar custo
        </button>
        <button className="faz-btn sm" type="button" onClick={() => alert("Pesagens entram no próximo patch.")}>
          Registrar pesagem
        </button>
        <button className="faz-btn sm" type="button" onClick={() => alert("Transferências ficam em Operação → Movimentações.")}>
          Transferir lote/animal
        </button>
      </div>

      <div className="faz-muted" style={{ marginTop: 10, fontSize: 12 }}>
        Dica: registre custos no dia a dia e as saídas quando vender/abater. O R$/@ do mês fica automático.
      </div>
    </div>
  </div>
</div>


        <Modal open={openExit} title="Registrar venda/saída" onClose={() => setOpenExit(false)}>
          <div className="faz-form-grid" style={{ marginTop: 4 }}>
            <div>
              <label className="form-label">@ (arrobas) vendidas/abatidas</label>
              <input className="input" type="number" min="0" step="0.01" value={exitArrobas} onChange={(e)=>setExitArrobas(e.target.value)} />
            </div>
            <div>
              <label className="form-label">Valor total (R$)</label>
              <input className="input" type="number" min="0" step="0.01" value={exitValue} onChange={(e)=>setExitValue(e.target.value)} />
            </div>
          </div>
          <div style={{ display: "flex", gap: 10, justifyContent: "flex-end", marginTop: 12 }}>
            <button className="faz-btn" type="button" onClick={() => setOpenExit(false)}>Cancelar</button>
            <button className="faz-btn primary" type="button" onClick={registerExit}>Salvar</button>
          </div>
        </Modal>

        <Modal open={openCost} title="Lançar custo" onClose={() => setOpenCost(false)}>
          <div className="faz-form-grid" style={{ marginTop: 4 }}>
            <div>
              <label className="form-label">Grupo</label>
              <select className="input" value={costGroup} onChange={(e)=>setCostGroup(e.target.value)}>
                <option>Pasto</option>
                <option>Nutrição</option>
                <option>Sanidade/Reprodução</option>
                <option>Operação</option>
                <option>Máquinas/Infra/Outros</option>
              </select>
            </div>
            <div>
              <label className="form-label">Valor (R$)</label>
              <input className="input" type="number" min="0" step="0.01" value={costValue} onChange={(e)=>setCostValue(e.target.value)} />
            </div>
          </div>
          <div style={{ display: "flex", gap: 10, justifyContent: "flex-end", marginTop: 12 }}>
            <button className="faz-btn" type="button" onClick={() => setOpenCost(false)}>Cancelar</button>
            <button className="faz-btn primary" type="button" onClick={registerCost}>Salvar</button>
          </div>
        </Modal>
      </div>
    </div>
    </>
  );
}
