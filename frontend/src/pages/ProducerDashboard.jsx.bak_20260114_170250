import React, { useEffect, useMemo, useState } from "react";
import CrasPageHeader from "../components/CrasPageHeader.jsx";
import { api, getApiBase } from "../lib/api.js";

function formatBRL(v){
  const n = Number(v);
  if (!Number.isFinite(n)) return "—";
  try { return n.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }); } catch { return `R$ ${n}`; }
}

function formatBRLPerArroba(v){
  const n = Number(v);
  if (!Number.isFinite(n)) return "—";
  return `${formatBRL(n)}/@`;
}

function fmtInt(v){
  const n = Number(v);
  if (!Number.isFinite(n)) return "0";
  return n.toLocaleString("pt-BR");
}

function Modal({ open, title, children, onClose }){
  if (!open) return null;
  return (
    <div className="faz-modal-backdrop" role="dialog" aria-modal="true">
      <div className="faz-modal">
        <div className="faz-modal-head">
          <div>
            <div className="faz-modal-title">{title}</div>
            <div className="faz-modal-sub">Registro rápido (entra no relatório do mês)</div>
          </div>
          <button className="faz-btn" type="button" onClick={onClose}>Fechar</button>
        </div>
        <div className="faz-modal-body">{children}</div>
      </div>
    </div>
  );
}

function EmptyState({ title, subtitle }){
  return (
    <div className="faz-empty">
      <div className="faz-empty-ic">📌</div>
      <div>
        <div className="faz-empty-title">{title}</div>
        <div className="faz-empty-sub">{subtitle}</div>
      </div>
    </div>
  );
}

export default function ProducerDashboard({ monthKey, onMonthChange }){
  const [loading, setLoading] = useState(false);
  const [err, setErr] = useState(null);
  const [data, setData] = useState(null);

  const [openExit, setOpenExit] = useState(false);
  const [exitArrobas, setExitArrobas] = useState(0);
  const [exitValue, setExitValue] = useState(0);

  const [openCost, setOpenCost] = useState(false);
  const [costGroup, setCostGroup] = useState("Nutrição");
  const [costValue, setCostValue] = useState(0);

  const apiBase = useMemo(() => getApiBase(), []);

  async function load(){
    setLoading(true);
    setErr(null);
    try {
      const res = await api.get(`/producer/monthly-summary?month=${encodeURIComponent(monthKey)}`);
      setData(res);
    } catch (e){
      setErr(e?.message || "Falha ao carregar");
      setData(null);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => { load(); /* eslint-disable-next-line */ }, [monthKey]);

  const hasArrobas = Number(data?.arrobas || 0) > 0;
  const hasCosts = Number(data?.cost_total_brl || 0) > 0;
  const hasSales = Number(data?.price_avg_brl || 0) > 0;

  const kpis = useMemo(() => ([
    { label: "@ produzidas (mês)", value: `${fmtInt(data?.arrobas || 0)} @`, sub: `Período: ${data?.month_label || monthKey}` },
    { label: "Custo (R$/@)", value: (data?.cost_per_arroba_brl == null ? "—" : formatBRLPerArroba(data.cost_per_arroba_brl)), sub: "Sempre por arroba produzida" },
    { label: "Preço médio (R$/@)", value: (data?.price_avg_brl == null ? "—" : formatBRLPerArroba(data.price_avg_brl)), sub: "Vendas/abates do mês" },
    { label: "Margem (R$/@)", value: (data?.margin_per_arroba_brl == null ? "—" : formatBRLPerArroba(data.margin_per_arroba_brl)), sub: "Preço − custo" },
    { label: "Margem total (R$)", value: (data?.margin_total_brl == null ? "—" : formatBRL(data.margin_total_brl)), sub: "Margem/@ × @ vendidas" },
  ]), [data, monthKey]);

  const top5 = useMemo(() => {
    const rows = data?.top_costs || [];
    const total = Number(data?.cost_total_brl || 0);
    const arrobas = Number(data?.arrobas || 0);
    return rows.map((x) => {
      const val = Number(x.value_brl || 0);
      const pct = total > 0 ? (val / total) : 0;
      const impact = arrobas > 0 ? `+${formatBRL(val/arrobas)}/@` : "";
      return { name: x.group, pct, val, impact };
    });
  }, [data]);

  const alerts = useMemo(() => (data?.alerts ? data.alerts.map(a => a.text) : []), [data]);
  const summaryLines = useMemo(() => (data?.summary_lines || []), [data]);

  const trend = useMemo(() => {
    const t = Array.isArray(data?.trend) ? data.trend : [];
    const values = t.map(x => Number(x.cost_per_arroba_brl)).filter(Number.isFinite);
    const max = values.length ? Math.max(...values) : 0;
    return { rows: t, max };
  }, [data]);

  async function createExit(){
    const arrobas = Number(exitArrobas || 0);
    const value = Number(exitValue || 0);
    if (!(arrobas > 0)) return alert("Informe as arrobas da saída.");
    try {
      await api.post("/events", {
        source: "app",
        status: "approved",
        type: "exit",
        raw_text: `Saída — ${arrobas} @ — ${formatBRL(value)}`,
        payload: { arrobas, value_brl: value },
      });
      setOpenExit(false);
      setExitArrobas(0);
      setExitValue(0);
      await load();
      alert("Saída registrada.");
    } catch (e){
      alert(e?.message || "Falha ao registrar saída");
    }
  }

  async function createCost(){
    const value = Number(costValue || 0);
    if (!(value > 0)) return alert("Informe o valor do custo.");
    try {
      await api.post("/events", {
        source: "app",
        status: "approved",
        type: "cost",
        raw_text: `Custo — ${costGroup} — ${formatBRL(value)}`,
        payload: { group: costGroup, value_brl: value },
      });
      setOpenCost(false);
      setCostValue(0);
      await load();
      alert("Custo lançado.");
    } catch (e){
      alert(e?.message || "Falha ao lançar custo");
    }
  }

  return (
    <div className="cras-stage-v2">
      <CrasPageHeader
        kicker="RELATÓRIO DO PRODUTOR"
        title="Resumo do mês"
        subtitle="Custo sempre em R$/@ produzida — leitura rápida e objetiva."
        chips={[
          { label: "Mês", active: true },
          { label: data?.month_label || monthKey, active: true },
          { label: "R$/@", active: true },
        ]}
        actions={[
          { key: "reload", label: loading ? "Atualizando..." : "Atualizar", tone: "primary" },
        ]}
        onAction={(a) => { if (a?.key === "reload") load(); }}
      />

      <div className="cras-stage-body">
        {err ? (
          <div className="faz-callout danger" style={{ marginBottom: 10 }}>
            <div className="ic">!</div>
            <div className="tx">Falha ao carregar dados do backend: <b>{err}</b></div>
          </div>
        ) : null}

        <div className="faz-grid-kpis faz-grid-kpis--compact">
          {kpis.map((k) => (
            <div key={k.label} className="faz-kpi">
              <div className="label">{k.label}</div>
              <div className="value">{k.value}</div>
              <div className="sub">{k.sub}</div>
            </div>
          ))}
        </div>

        <div className="faz-dash-bottom">
          <div className="faz-col">
            <div className="faz-panel">
              <div className="faz-panel-head">
                <div>
                  <h3>Evolução do custo (R$/@)</h3>
                  <div className="faz-muted" style={{ marginTop: 4 }}>Últimos 6 meses (tendência do backend).</div>
                </div>
              </div>

              {trend.rows?.length ? (
                (trend.max > 0 ? (
                  <div className="faz-trend-list">
                    {trend.rows.map((t) => {
                      const v = Number(t.cost_per_arroba_brl);
                      const pct = (Number.isFinite(v) && trend.max > 0) ? Math.max(0.06, v / trend.max) : 0;
                      return (
                        <div className="faz-trend-item" key={t.month}>
                          <div className="m">{t.month_label}</div>
                          <div className="bar">
                            <div className="fill" style={{ width: `${pct*100}%` }} />
                          </div>
                          <div className="v">{t.cost_per_arroba_brl == null ? "—" : formatBRLPerArroba(t.cost_per_arroba_brl)}</div>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <EmptyState
                    title="Sem histórico suficiente"
                    subtitle="Quando houver custos e @ produzida em meses anteriores, a tendência aparece aqui."
                  />
                ))
              ) : (
                <EmptyState title="Sem tendência" subtitle="Ainda não há dados para montar a tendência." />
              )}
            </div>

            <div className="faz-panel" style={{ marginTop: 12 }}>
              <div className="faz-panel-head">
                <div>
                  <h3>O que mais puxou seu custo</h3>
                  <div className="faz-muted" style={{ marginTop: 4 }}>
                    Top 5 categorias (fixas) · Total no mês: <b>{formatBRL(data?.cost_total_brl || 0)}</b>
                  </div>
                </div>
                <div className="faz-head-metrics">
                  <div className="faz-metric">
                    <div className="k">R$/@</div>
                    <div className="v">{data?.cost_per_arroba_brl == null ? "—" : formatBRLPerArroba(data.cost_per_arroba_brl)}</div>
                  </div>
                </div>
              </div>

              {!hasCosts ? (
                <EmptyState title="Sem custos registrados no mês" subtitle='Use “Lançar custo” (ao lado) ou registre via WhatsApp para aparecer aqui.' />
              ) : (
                <div className="faz-bars faz-bars-compact">
                  {top5.map((b) => (
                    <div key={b.name} className="faz-bar">
                      <div className="name">{b.name}</div>
                      <div className="track"><div className="fill" style={{ width: `${Math.round(b.pct*100)}%` }} /></div>
                      <div className="val">
                        <div className="n">{formatBRL(b.val)}</div>
                        <div className="i">{b.impact}</div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div className="faz-col">
            <div className="faz-panel">
              <div className="faz-panel-head">
                <div>
                  <h3>Resumo do mês</h3>
                  <div className="faz-muted" style={{ marginTop: 4 }}>
                    Leitura rápida e acionável (modo produtor).
                  </div>
                </div>
              </div>

              <div className="faz-summary-lines">
                {summaryLines.length ? summaryLines.map((l, i) => (
                  <div key={i} className="faz-sline">
                    <span className="dot" />
                    <span className="t">{l}</span>
                  </div>
                )) : (
                  <div className="faz-muted">Sem dados.</div>
                )}
              </div>

              {!hasArrobas ? (
                <div className="faz-callout info" style={{ marginTop: 10 }}>
                  <div className="ic">i</div>
                  <div className="tx">Sem @ produzida no mês. Registre <b>saída</b> (venda/abate) ou <b>pesagens</b> para calcular R$/@.</div>
                </div>
              ) : null}

              {alerts.length ? (
                <div className="faz-alerts-compact" style={{ marginTop: 12 }}>
                  {alerts.slice(0, 5).map((t, i) => (
                    <div key={i} className="faz-alert faz-alert-compact">
                      <div className="dot" />
                      <div className="txt">{t}</div>
                    </div>
                  ))}
                </div>
              ) : null}
            </div>

            <div className="faz-panel" style={{ marginTop: 12 }}>
              <div className="faz-panel-head">
                <div>
                  <h3>Ações rápidas</h3>
                  <div className="faz-muted" style={{ marginTop: 4 }}>
                    Registre custos e saídas para o R$/@ fechar automático.
                  </div>
                </div>
              </div>

              <div className="faz-quick-grid">
                <button className="faz-btn primary sm" type="button" onClick={() => setOpenExit(true)}>
                  Registrar venda/saída
                </button>
                <button className="faz-btn sm" type="button" onClick={() => setOpenCost(true)}>
                  Lançar custo
                </button>
                <button className="faz-btn sm" type="button" onClick={() => alert("Pesagens entram no próximo patch.")}>
                  Registrar pesagem
                </button>
                <button className="faz-btn sm" type="button" onClick={() => alert("Transferências ficam em Operação → Movimentações.")}>
                  Transferir lote/animal
                </button>
              </div>

              <div className="faz-muted" style={{ marginTop: 10, fontSize: 12 }}>
                API: <b>{apiBase}</b>
              </div>
            </div>
          </div>
        </div>

        <Modal open={openExit} title="Registrar venda/saída" onClose={() => setOpenExit(false)}>
          <div className="form-grid">
            <div>
              <label className="form-label">Arrobas (@)</label>
              <input className="input" value={exitArrobas} onChange={(e)=>setExitArrobas(e.target.value)} placeholder="Ex.: 120" />
            </div>
            <div>
              <label className="form-label">Valor total (R$)</label>
              <input className="input" value={exitValue} onChange={(e)=>setExitValue(e.target.value)} placeholder="Ex.: 42000" />
            </div>
          </div>
          <div className="form-actions">
            <button className="faz-btn" type="button" onClick={() => setOpenExit(false)}>Cancelar</button>
            <button className="faz-btn primary" type="button" onClick={createExit}>Salvar</button>
          </div>
        </Modal>

        <Modal open={openCost} title="Lançar custo" onClose={() => setOpenCost(false)}>
          <div className="form-grid">
            <div>
              <label className="form-label">Categoria</label>
              <select className="input" value={costGroup} onChange={(e)=>setCostGroup(e.target.value)}>
                <option>Pasto</option>
                <option>Nutrição</option>
                <option>Sanidade/Reprodução</option>
                <option>Operação</option>
                <option>Máquinas/Infra/Outros</option>
              </select>
            </div>
            <div>
              <label className="form-label">Valor (R$)</label>
              <input className="input" value={costValue} onChange={(e)=>setCostValue(e.target.value)} placeholder="Ex.: 1500" />
            </div>
          </div>
          <div className="form-actions">
            <button className="faz-btn" type="button" onClick={() => setOpenCost(false)}>Cancelar</button>
            <button className="faz-btn primary" type="button" onClick={createCost}>Salvar</button>
          </div>
        </Modal>
      </div>
    </div>
  );
}
