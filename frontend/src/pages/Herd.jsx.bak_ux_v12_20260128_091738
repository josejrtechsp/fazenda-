      const data = await api.get("/herd/animals?all=1&limit=2000");
      if (Array.isArray(data?.animals) && data.animals.length){
        setAnimalsAll(data.animals);
        return;
      }
      // se veio vazio, tenta fallback por lote (evita "0 itens" indevido)
    } catch {
      // fallback per-lot
    }

    const lotList = ll || lots;
    if (!lotList.length){
      setAnimalsAll([]);
      return;
    }

    const res = await Promise.all(
      lotList.map(async (l) => {
        try {
          const d = await api.get(`/herd/animals?lot_id=${encodeURIComponent(l.id)}&limit=2000`);
          const arr = (d?.animals || []).map(a => ({ ...a, lot_id: Number(a.lot_id ?? l.id) }));
          return arr;
        } catch {
          return [];
        }
      })
    );

    const flat = res.flat();
    setAnimalsAll(flat);
  }

