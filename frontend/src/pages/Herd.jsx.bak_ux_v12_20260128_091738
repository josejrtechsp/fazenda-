function fmtInt(n){
  try { return Number(n).toLocaleString("pt-BR"); } catch { return String(n); }
}

function fmtKg(n){
  if (n == null || Number.isNaN(Number(n))) return "—";
  return `${fmtInt(Math.round(Number(n)))} kg`;
}

function normalizeEarTag(s){
  return (s || "").toString().trim().replace(/[^0-9A-Za-z]/g, "").toUpperCase();
}


function fmtGmdValue(g){
  if (g == null || Number.isNaN(Number(g))) return { txt: "—", label: "none" };
  const x = Number(g);
  // evita "+0.00" vindo de arredondamento
  const val = Math.abs(x) < 0.005 ? 0 : x;
  let label = "neutro";
  if (val > 0.05) label = "pos";
  else if (val < -0.05) label = "neg";
  const sign = val > 0 ? "+" : "";
  const txtNum = val === 0 ? "0.00" : `${sign}${val.toFixed(2)}`;
  return { txt: txtNum, label };
}

function daysSinceIso(iso){
  try {
    if (!iso) return null;
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return null;
    const ms = Date.now() - d.getTime();
    return Math.max(0, Math.floor(ms / (1000*60*60*24)));
  } catch {
    return null;
  }
}

function fmtDateShort(iso){
  try {
    if (!iso) return "—";
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return "—";
    return d.toLocaleDateString("pt-BR");
  } catch {
    return "—";
  }
}

function coerceActionKey(a){
  return a?.key || a;
}

