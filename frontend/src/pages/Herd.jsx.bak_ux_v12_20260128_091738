  function applyLocalWeighing(earTag, weightKg, iso){
    const ear = normalizeEarTag(earTag);
    const kg = Number(weightKg);
    const patchOne = (a) => {
      if (!a) return a;
      const aEar = normalizeEarTag(a.ear_tag);
      if (aEar !== ear) return a;
      return {
        ...a,
        last_weight_kg: kg,
        last_weighed_at: iso,
        days_since_weigh: 0,
      };
    };

    setAnimalsAll((prev) => Array.isArray(prev) ? prev.map(patchOne) : prev);
    setAnimalsLot((prev) => Array.isArray(prev) ? prev.map(patchOne) : prev);

    try {
      const key = "fazenda_rebanho_local_weighings_v1";
      const cur = JSON.parse(localStorage.getItem(key) || "[]");
      const next = Array.isArray(cur) ? cur : [];
      next.push({ ear_tag: ear, weight_kg: kg, date_iso: iso, note: qwNote || "" });
      localStorage.setItem(key, JSON.stringify(next.slice(-500)));
    } catch {}
  }

