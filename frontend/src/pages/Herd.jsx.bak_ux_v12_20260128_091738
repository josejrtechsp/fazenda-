  function gmdBetween(w1, w2){
    try {
      if (!w1 || !w2) return null;
      const d1 = new Date(w1.weighed_at);
      const d2 = new Date(w2.weighed_at);
      const days = (d2.getTime() - d1.getTime()) / 86400000;
      if (!Number.isFinite(days) || days <= 0) return null;
      const delta = Number(w2.weight_kg) - Number(w1.weight_kg);
      if (!Number.isFinite(delta)) return null;
      return delta / days;
    } catch {
      return null;
    }
  }

  function svgPathFromWeights(ws){
    try {
      if (!Array.isArray(ws) || ws.length < 2) return null;
      const vals = ws.map(w => Number(w.weight_kg)).filter(v => Number.isFinite(v));
      if (vals.length < 2) return null;
      const min = Math.min(...vals);
      const max = Math.max(...vals);
      const pad = (max - min) === 0 ? 1 : (max - min) * 0.08;
      const lo = min - pad;
      const hi = max + pad;
      const n = ws.length;
      const pts = ws.map((w, i) => {
        const x = (i / (n - 1)) * 100;
        const y = 100 - ((Number(w.weight_kg) - lo) / (hi - lo)) * 100;
        return { x, y };
      });
      return "M " + pts.map(p => `${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(" L ");
    } catch {
      return null;
    }
  }

