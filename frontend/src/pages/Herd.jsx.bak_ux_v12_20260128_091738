                              {wsAsc.map((w, idx) => {
                                const prevW = idx > 0 ? wsAsc[idx-1] : null;
                                const delta = prevW ? (Number(w.weight_kg) - Number(prevW.weight_kg)) : null;
                                const g = prevW ? gmdBetween(prevW, w) : null;
                                return (
                                  <tr key={w.id || `${w.weighed_at}-${idx}`}>
                                    <td className="tdMuted">{fmtDateShort(w.weighed_at)}</td>
                                    <td>{fmtKg(w.weight_kg)}</td>
                                    <td className="tdMuted">{delta == null ? "—" : `${delta > 0 ? "+" : ""}${delta.toFixed(0)} kg`}</td>
                                    <td className="tdMuted">{g == null ? "—" : `${g.toFixed(2)} kg/d`}</td>
                                    <td className="tdMuted">{w.note || "—"}</td>
                                  </tr>
                                );
                              })}
                            </tbody>
                          </table>
                        </div>
                      </div>

                      <div className="faz-panel">
                        <div style={{ fontWeight: 950 }}>Timeline</div>
                        <div className="texto-suave">Nesta etapa: pesagens e status (eventos entram na próxima).</div>

                        <div style={{ marginTop: 10 }}>
                          {(() => {
                            const hsArr = Array.isArray(animalView.data?.health) ? animalView.data.health : [];
                            const hs = hsArr.map((h) => ({
                              _k: `h-${h.id}`,
                              kind: "health",
                              at: h.occurred_at,
                              title: `Sanidade • ${h.name || h.code || "Registro"}`,
                              sub: `${fmtDateShort(h.occurred_at)}${h.note ? ` • ${h.note}` : ""}`,
                            }));
                            const wsEv = wsAsc.map((w) => ({
                              _k: `w-${w.id}`,
                              kind: "weighing",
                              at: w.weighed_at,
                              title: `Pesagem • ${fmtKg(w.weight_kg)}`,
                              sub: `${fmtDateShort(w.weighed_at)}${w.note ? ` • ${w.note}` : ""}`,
                            }));
                            const items = [...hs, ...wsEv].filter(i => !!i.at).sort((a,b) => {
                              const da = new Date(a.at).getTime();
                              const db = new Date(b.at).getTime();
                              return db - da;
                            }).slice(0, 12);
                            return items.map((it) => (
                              <div key={it._k} className="faz-timeline-row">
                                <div className={`dot ${it.kind === "health" ? "health" : ""}`} aria-hidden="true" />
                                <div>
                                  <div style={{ fontWeight: 800 }}>{it.title}</div>
                                  <div className="texto-suave">{it.sub}</div>
                                </div>
                              </div>
                            ));
                          })()}
                          {ws.length === 0 ? (
                            <div className="texto-suave">Sem eventos ainda.</div>
                          ) : null}
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })()
            ) : null}
          </div>
        ) : null}

      </div>


      {qwOpen ? (
        <div className="faz-modalBack" role="dialog" aria-modal="true" onMouseDown={() => { setQwOpen(false); }}>
          <div className="faz-modal" onMouseDown={(e) => e.stopPropagation()}>
            <div className="faz-modalHead">
              <div>
                <div className="faz-modalTitle">Pesagem rápida</div>
                <div className="faz-modalSub">Lançamento rápido de curral (funciona mesmo sem backend: modo demo).</div>
              </div>
              <button className="faz-btn" type="button" onClick={() => setQwOpen(false)}>Fechar</button>
            </div>

            {qwErr ? (
              <div className="faz-modalErr">Falha: {qwErr}</div>
            ) : null}

            <div className="faz-modalGrid">
              <div>
                <label className="form-label">Brinco</label>
                <input className="faz-input" value={qwEar} onChange={(e) => setQwEar(e.target.value)} placeholder="Ex.: 7812 ou A2391" />
              </div>
              <div>
                <label className="form-label">Data</label>
                <input className="faz-input" type="date" value={qwDate} onChange={(e) => setQwDate(e.target.value)} />
              </div>
              <div>
                <label className="form-label">Peso (kg)</label>
                <input className="faz-input" value={qwKg} onChange={(e) => setQwKg(e.target.value)} placeholder="Ex.: 420" />
              </div>
              <div>
                <label className="form-label">Observação (opcional)</label>
                <input className="faz-input" value={qwNote} onChange={(e) => setQwNote(e.target.value)} placeholder="Ex.: balança 2, jejum, etc." />
              </div>
            </div>

            <div className="faz-modalActions">
              <button className="faz-btn" type="button" onClick={() => setQwOpen(false)}>Cancelar</button>
              <button className="faz-btn primary" type="button" disabled={qwSaving} onClick={submitQuickWeigh}>
                {qwSaving ? "Salvando..." : "Registrar pesagem"}
              </button>
            </div>
          </div>
        </div>
      ) : null}


      {baixaOpen ? (
        <div className="faz-modalBack" role="dialog" aria-modal="true" onMouseDown={() => { setBaixaOpen(false); }}>
          <div className="faz-modal" onMouseDown={(e) => e.stopPropagation()}>
            <div className="faz-modalHead">
              <div>
                <div className="faz-modalTitle">Dar baixa</div>
                <div className="faz-modalSub">Animal: <b>{baixaEar}</b></div>
              </div>
              <button className="faz-btn" type="button" onClick={() => setBaixaOpen(false)}>Fechar</button>
            </div>

            {baixaErr ? (
              <div className="faz-modalErr">Falha: {baixaErr}</div>
            ) : null}

            <div className="faz-modalGrid">
              <div>
                <label className="form-label">Tipo de baixa</label>
                <select className="faz-input" value={baixaKind} onChange={(e) => setBaixaKind(e.target.value)}>
                  <option value="venda">Venda</option>
                  <option value="morte">Morte</option>
                  <option value="descarte">Descarte</option>
                </select>
              </div>
              <div>
                <label className="form-label">Data</label>
                <input className="faz-input" type="date" value={baixaDate} onChange={(e) => setBaixaDate(e.target.value)} />
              </div>
              <div>
                <label className="form-label">Peso (kg) (opcional)</label>
                <input className="faz-input" value={baixaKg} onChange={(e) => setBaixaKg(e.target.value)} placeholder="Ex.: 480" />
              </div>
              <div>
                <label className="form-label">Valor (R$) (opcional)</label>
                <input className="faz-input" value={baixaBrl} onChange={(e) => setBaixaBrl(e.target.value)} placeholder="Ex.: 8.500" />
              </div>
            </div>

            <div style={{ marginTop: 10 }}>
              <label className="form-label">Observação</label>
              <textarea className="faz-input" value={baixaNote} onChange={(e) => setBaixaNote(e.target.value)} rows={3} placeholder="Ex.: venda a prazo, motivo, comprador, etc." style={{ width: "100%" }} />
            </div>

            <div className="faz-modalActions">
              <button className="faz-btn" type="button" onClick={() => setBaixaOpen(false)}>Cancelar</button>
              <button className="faz-btn primary" type="button" disabled={baixaSaving} onClick={submitBaixa}>
                {baixaSaving ? "Salvando..." : "Confirmar baixa"}
              </button>
            </div>
          </div>
        </div>
      ) : null}

    </div>
  );
}
