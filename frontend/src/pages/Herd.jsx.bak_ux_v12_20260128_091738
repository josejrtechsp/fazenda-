  }, [lots]);

  const filteredAnimalsAll = useMemo(() => {
    let list = Array.isArray(animalsAll) ? [...animalsAll] : [];

    const qq = normalizeEarTag(qAll);
    if (qq) list = list.filter(a => normalizeEarTag(a.ear_tag).includes(qq));

    if (fCategory !== "ALL") list = list.filter(a => String(a.category) === fCategory);

    if (fLot !== "ALL") list = list.filter(a => String(a.lot_id) === String(fLot));

    if (onlyStale){
      list = list.filter(a => {
        const ds = animalDays(a);
        return ds != null && ds > Number(staleDays);
      });
    }

    if (onlyNegGmd){
      list = list.filter(a => {
        const g = animalGmd(a);
        return g != null && g < -0.05;
      });
    }

    // sort
    list.sort((a,b) => {
      if (sortKey === "ear") return String(a.ear_tag).localeCompare(String(b.ear_tag));

      if (sortKey === "weight"){
        const aw = Number(a.last_weight_kg ?? -1);
        const bw = Number(b.last_weight_kg ?? -1);
        return bw - aw;
      }

      if (sortKey === "gmd"){
        const ag = animalGmd(a);
        const bg = animalGmd(b);
        // pior primeiro: menor valor (mais negativo)
        if (ag == null && bg == null) return 0;
        if (ag == null) return 1;
        if (bg == null) return -1;
        return ag - bg;
      }

      // stale (default): maior dias primeiro
      const ad = animalDays(a);
      const bd = animalDays(b);
      if (ad == null && bd == null) return 0;
      if (ad == null) return 1;
      if (bd == null) return -1;
      return bd - ad;
    });

