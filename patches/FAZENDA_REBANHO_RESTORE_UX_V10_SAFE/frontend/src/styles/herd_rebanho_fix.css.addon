/* =========================================================
   UX V10 — Rebanho (Overview painel + Animais em cards)
   Escopo: apenas dentro da aba Rebanho (.faz-herd)
   ========================================================= */

.faz-herd .faz-kpiGrid{
  display:grid;
  grid-template-columns:repeat(4,minmax(160px,1fr));
  gap:10px;
  margin-top:10px;
}
@media (max-width: 980px){
  .faz-herd .faz-kpiGrid{ grid-template-columns:repeat(2,minmax(150px,1fr)); }
}

.faz-herd .faz-kpiCard{
  border:1px solid rgba(226,232,240,.92);
  background:#fff;
  border-radius:16px;
  padding:12px 12px;
  text-align:left;
  cursor:pointer;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
  transition:transform .06s ease, border-color .12s ease, background .12s ease;
  min-height:86px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.faz-herd .faz-kpiCard:hover{
  border-color:rgba(124,58,237,.55);
  background:rgba(124,58,237,.04);
  transform:translateY(-1px);
}
.faz-herd .faz-kpiCard .k{
  font-size:11px;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:rgba(100,116,139,1);
  font-weight:900;
}
.faz-herd .faz-kpiCard .v{
  margin-top:6px;
  font-size:22px;
  font-weight:950;
  color:rgba(15,23,42,1);
  line-height:1.1;
}
.faz-herd .faz-kpiCard .s{
  margin-top:4px;
  font-size:12px;
  color:rgba(100,116,139,1);
  font-weight:650;
}

.faz-herd .faz-panels{
  display:grid;
  grid-template-columns: 1.2fr .8fr;
  gap:12px;
  margin-top:12px;
}
@media (max-width: 980px){
  .faz-herd .faz-panels{ grid-template-columns:1fr; }
}

.faz-herd .faz-catGrid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
  gap:10px;
  margin-top:10px;
}
.faz-herd .faz-catBtn{
  border:1px solid rgba(226,232,240,.92);
  background:#fff;
  border-radius:14px;
  padding:10px 12px;
  cursor:pointer;
  text-align:left;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
}
.faz-herd .faz-catBtn:hover{
  border-color:rgba(124,58,237,.55);
  background:rgba(124,58,237,.04);
}
.faz-herd .faz-catBtn .top{
  display:flex;
  align-items:baseline;
  justify-content:space-between;
  gap:10px;
}
.faz-herd .faz-catBtn .name{
  font-weight:950;
  color:rgba(15,23,42,1);
  font-size:13px;
}
.faz-herd .faz-catBtn .num{
  font-weight:950;
  color:rgba(15,23,42,1);
  font-size:14px;
}
.faz-herd .faz-catBtn .sub{
  margin-top:3px;
  font-size:12px;
  color:rgba(100,116,139,1);
  font-weight:650;
}

.faz-herd .faz-toggles{
  display:flex;
  gap:8px;
  align-items:center;
  flex-wrap:wrap;
}

.faz-herd .faz-toggle{
  border:1px solid rgba(226,232,240,.95);
  background:#fff;
  border-radius:999px;
  padding:7px 10px;
  font-size:12px;
  font-weight:900;
  cursor:pointer;
  line-height:1;
  box-shadow:0 10px 26px rgba(15,23,42,.06);
}
.faz-herd .faz-toggle.is-on{
  border-color:rgba(124,58,237,.60);
  background:rgba(124,58,237,.08);
}

.faz-herd .faz-emptyNice{
  border:1px dashed rgba(226,232,240,1);
  background:rgba(241,245,249,.6);
  border-radius:16px;
  padding:14px;
  color:rgba(71,85,105,1);
  font-weight:650;
}

/* Lista de lotes e animais (caso ainda não exista no css atual) */
.faz-herd .faz-lots{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-top:10px;
}
.faz-herd .faz-lot-row{
  width:100%;
  border:1px solid rgba(226,232,240,.92);
  background:#fff;
  border-radius:14px;
  padding:10px 12px;
  cursor:pointer;
  text-align:left;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
}
.faz-herd .faz-lot-row:hover{
  border-color:rgba(124,58,237,.45);
  background:rgba(124,58,237,.04);
}
.faz-herd .faz-lot-row.is-active{
  border-color:rgba(124,58,237,.65);
  box-shadow:0 18px 52px rgba(124,58,237,.10);
}
.faz-herd .faz-lot-row .left .name{
  font-weight:950;
  color:rgba(15,23,42,1);
  font-size:14px;
}
.faz-herd .faz-lot-row .left .sub{
  margin-top:2px;
  font-size:12px;
  color:rgba(100,116,139,1);
  font-weight:650;
}
.faz-herd .faz-lot-row .right{
  text-align:right;
  min-width:72px;
}
.faz-herd .faz-lot-row .right .num{
  font-weight:950;
  font-size:16px;
  color:rgba(15,23,42,1);
  line-height:1.1;
}
.faz-herd .faz-lot-row .right .muted{
  font-size:11px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:rgba(100,116,139,1);
  font-weight:900;
  margin-top:2px;
}

.faz-herd .faz-animals{
  margin-top:10px;
  display:flex;
  flex-direction:column;
  gap:8px;
}
.faz-herd .faz-animal-row{
  border:1px solid rgba(226,232,240,.92);
  background:#fff;
  border-radius:14px;
  padding:10px 12px;
  box-shadow:0 14px 40px rgba(15,23,42,.06);
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}
.faz-herd .faz-animal-row .meta{
  color:rgba(100,116,139,1);
  font-size:12px;
  font-weight:650;
  flex:1 1 260px;
  min-width:220px;
}
.faz-herd .faz-animal-row.is-alert{
  border-color:rgba(245,158,11,.55);
  background:rgba(245,158,11,.06);
}
