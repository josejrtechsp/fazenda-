{tab === "operate" && (
  <div className="card">
    <div className="card-header-row" style={{ alignItems: "flex-start" }}>
      <div>
        <div style={{ fontWeight: 900 }}>Operar (modo vaqueiro)</div>
        <div className="card-subtitle">
          Brinco → peso → registrar. Rápido, sem tabelas.
        </div>
      </div>

      <div className="faz-actions-row" style={{ marginLeft: "auto" }}>
        <button className="faz-btn" type="button" onClick={() => setTab("animals")}>Animais</button>
        <button className="faz-btn" type="button" onClick={() => setTab("lots")}>Mangas</button>
        <button className="faz-btn" type="button" onClick={seedDemo}>Demo</button>
      </div>
    </div>

    <div className="faz-detail-grid" style={{ marginTop: 12 }}>
      <div>
        <label className="form-label">Brinco</label>
        <input
          ref={opEarRef}
          className="input"
          value={opQ}
          onChange={(e) => setOpQ(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === "Escape") {
              setOpQ("");
              setOpPeso("");
              setOpMsg("");
              return;
            }
            if (e.key === "Enter" && e.ctrlKey) {
              if (opExact) openFicha(opExact.ear_tag);
              return;
            }
            if (e.key !== "Enter") return;
            if (opExact) {
              // vai direto para peso
              requestAnimationFrame(() => opPesoRef?.current?.focus());
            }
          }}
          placeholder="Ex.: A2402, N901, 7812..."
        />
        <div className="texto-suave" style={{ marginTop: 6 }}>
          Enter = ir para peso • Ctrl+Enter = ficha • Esc = limpar
        </div>
      </div>

      <div>
        <label className="form-label">Manga (destino)</label>
        <select
          className="input"
          value={opMangaId}
          onChange={(e) => setOpMangaId(e.target.value)}
        >
          <option value="__KEEP__">Manter manga atual</option>
          {opMangas.map((m) => (
            <option key={String(m.id)} value={String(m.id)}>
              {m.name}
            </option>
          ))}
        </select>
        <div className="texto-suave" style={{ marginTop: 6 }}>
          Use para movimentação rápida (pendente).
        </div>
      </div>

      <div>
        <label className="form-label">Peso (kg)</label>
        <input
          ref={opPesoRef}
          className="input"
          inputMode="decimal"
          value={opPeso}
          onChange={(e) => setOpPeso(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === "Escape") {
              setOpPeso("");
              setOpMsg("");
              requestAnimationFrame(() => opEarRef?.current?.focus());
              return;
            }
            if (e.key !== "Enter") return;
            onOpRegistrarPesagem();
          }}
          placeholder="Ex.: 212"
        />
        <div className="texto-suave" style={{ marginTop: 6 }}>
          Enter = registrar pesagem (pendente) e voltar para brinco
        </div>
      </div>

      <div>
        <label className="form-label">Data</label>
        <input
          className="input"
          type="date"
          value={opData}
          onChange={(e) => setOpData(e.target.value)}
        />
        <div className="texto-suave" style={{ marginTop: 6 }}>
          Padrão: hoje
        </div>
      </div>
    </div>

    {opExact ? (
      <div className="card" style={{ marginTop: 12, border: "1px solid rgba(226,232,240,.92)" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10, flexWrap: "wrap" }}>
          <button type="button" className="link ear" onClick={() => openFicha(opExact.ear_tag)} style={{ fontWeight: 950 }}>
            {opExact.ear_tag}
          </button>
          <span className="pill">{opExact.category || "—"}</span>
          <span className="pill">{opLotLabel(opExact)}</span>
          <span className="pill">{fmtKg(opExact.last_weight_kg)}</span>
          <span className="pill">{opLastInfo(opExact)}</span>

          <div style={{ marginLeft: "auto", display: "flex", gap: 8, flexWrap: "wrap" }}>
            <button className="faz-btn" type="button" onClick={() => openFicha(opExact.ear_tag)}>Ficha</button>
            <button className="faz-btn primary" type="button" onClick={onOpRegistrarPesagem}>Registrar</button>
            <button className="faz-btn" type="button" onClick={onOpRegistrarMover}>Mover</button>
            <button className="faz-btn" type="button" onClick={() => openBaixa(opExact.ear_tag)}>Baixa</button>
          </div>
        </div>

        {opMsg ? (
          <div className="texto-suave" style={{ marginTop: 10 }}>
            {opMsg}
          </div>
        ) : null}
      </div>
    ) : (
      <div className="faz-emptyNice" style={{ marginTop: 12 }}>
        Digite um brinco para carregar o animal. Se não tiver dados, clique em <b>Demo</b>.
      </div>
    )}

    <div className="card" style={{ marginTop: 12, border: "1px solid rgba(226,232,240,.92)" }}>
      <div className="card-header-row">
        <div>
          <div style={{ fontWeight: 900 }}>Log do dia (pendências)</div>
          <div className="card-subtitle">Fica salvo no navegador (para sincronizar depois).</div>
        </div>
        <div style={{ marginLeft: "auto", display: "flex", gap: 8 }}>
          <button className="faz-btn" type="button" onClick={onOpLimparLog}>Limpar</button>
        </div>
      </div>

      {opLog.length === 0 ? (
        <div className="texto-suave">Nenhuma operação registrada ainda.</div>
      ) : (
        <div className="faz-animals" style={{ marginTop: 10 }}>
          {opLog.slice(0, 10).map((it) => (
            <div key={it.id} className="faz-animal-row">
              <div className="meta">
                <span className="ear">{it.ear}</span>
                {" • "}{it.type === "weigh" ? `Pesagem ${it.kg}kg` : `Mover para ${it.to || "—"}`}
                {" • "}{it.date}
              </div>
              <span className="pill">{it.type === "weigh" ? "PESAGEM" : "MOVIMENTAÇÃO"}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
)}

