# IDEAL Fazenda - Backend
FAZENDA_ENV=dev
FAZENDA_DB_URL=sqlite:///./fazenda.db
FAZENDA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WhatsApp (opcional - para webhook real)
WA_VERIFY_TOKEN=change-me
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_AUDIO_AUTO_TRANSCRIBE=1
WA_AUDIO_MAX_MB=20

# OpenAI (opcional - necessário para transcrição de áudio)
OPENAI_API_KEY=
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
OPENAI_AUDIO_LANGUAGE=pt
